# このファイルを .env にコピーして値を入れる（.env はコミットしない）

PORT=
JWT_SECRET=
PASSWORD=

MYSQL_HOST=
# 未設定なら 3306
MYSQL_PORT=
MYSQL_USER=
MYSQL_PASSWORD=
MYSQL_DATABASE=portfolio

# このAPIの公開 URL（例: https://api.example.com）。プロフィール写真の URL に使う
# 未設定なら、リクエストのホスト名から作る
PUBLIC_API_URL=

# HTTPS 用の証明書（本番のみ）。未設定なら HTTP で起動する
KEY_PATH=
CERT_PATH=
